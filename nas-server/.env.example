# 复制为 .env 后按实际网络修改
# NAS 在局域网中的固定 IP（建议先在路由器里给 NAS 绑定静态 IP / DHCP 保留）
NAS_LAN_IP=192.168.1.10

# 对外端口（App 端 local.properties 必须一致）
PMS_PORT=8080
TILE_PORT=8090

# 接口鉴权：留空 = 不校验。App 的 OkHttp 未携带自定义 Header，
# 若在这里填值，需要同时改造 App 的 AppModule 加拦截器，否则会 401。
API_TOKEN=

# 首次启动是否写入 3 条示例线路（验收用）。正式台账导入后可改为 0
SEED_DEMO=1

# 从天地图预下载瓦片时使用（tools/fetch_tiles.py 读取）
TIANDITU_KEY=

# 可选：让 /health 返回的推荐配置改用 nginx 8090 承担瓦片（性能更好）。
# 填完整前缀即可，不要带 /tiles/...，例如 http://192.168.1.10:8090
# 留空 = App 使用 8080 内置瓦片路由，NAS 只需开一个端口。
TILE_PUBLIC_URL=

# 复制为 .env 后按实际网络修改
# NAS 在局域网中的固定 IP（建议先在路由器里给 NAS 绑定静态 IP / DHCP 保留）
NAS_LAN_IP=192.168.1.10

# 对外端口（App 端 local.properties 必须一致）
PMS_PORT=8080
TILE_PORT=8090

# 接口鉴权：留空 = 不校验。App 的 OkHttp 未携带自定义 Header，
# 若在这里填值，需要同时改造 App 的 AppModule 加拦截器，否则会 401。
API_TOKEN=

# 首次启动是否写入 3 条示例线路（验收用）。正式台账导入后可改为 0
SEED_DEMO=1

# 从天地图预下载瓦片时使用（tools/fetch_tiles.py 读取）
TIANDITU_KEY=

# 可选：让 /health 返回的推荐配置改用 nginx 8090 承担瓦片（性能更好）。
# 填完整前缀即可，不要带 /tiles/...，例如 http://192.168.1.10:8090
# 留空 = App 使用 8080 内置瓦片路由，NAS 只需开一个端口。
TILE_PUBLIC_URL=

# ---- 镜像拉取（飞牛 fnOS / 国内 NAS 高频故障点）----
# fnOS 自带的加速源 docker.fnnas.com 经常不可达或返回 401，导致构建卡在
# "load metadata for docker.io/library/python:3.11-slim"。留空 = 走 Docker Hub 默认。
# 出问题时填可用加速源的完整镜像名，例如：
#   BASE_IMAGE=docker.1ms.run/library/python:3.11-slim
#   TILES_IMAGE=docker.1ms.run/library/nginx:1.27-alpine
# 备选加速源：docker.1panel.live、阿里云「容器镜像服务」给你的个人加速器地址。
BASE_IMAGE=
TILES_IMAGE=
# 构建时 pip 装不上依赖时填国内源，例如 https://pypi.tuna.tsinghua.edu.cn/simple
PIP_INDEX_URL=
